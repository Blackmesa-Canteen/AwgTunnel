# --- Engine working copies ---------------------------------------------------
# No upstream source is tracked here. The Flatpak build fetches the engine from
# the commit pinned in the manifest and rebuilds its vendor/ tree from the
# sha256-pinned archives in go.mod.yml. Local checkouts, made by
# scripts/update-engine.sh or by hand for the e2e suite, are scratch.
/vendor/

# --- Flatpak build output ----------------------------------------------------
/.flatpak-builder/
/builddir/
/build/
/build-dir/
/repo/
*.flatpak

# --- Meson -------------------------------------------------------------------
/subprojects/*/
!/subprojects/*.wrap

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/

# --- Scratch space -----------------------------------------------------------
# Local experiments; never part of a build.
/.work/

# --- Editors and desktops ----------------------------------------------------
.idea/
*.swp
*~
.DS_Store
/.claude/

# --- Secrets -----------------------------------------------------------------
# Guard against a real tunnel profile being committed by accident: they carry
# private keys. The test fixtures build their key material in Python instead.
*.conf
!data/**/*.conf
